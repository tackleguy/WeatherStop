# WeatherStop local / server env (copy to `.env` — never commit secrets)

# --- Local AI backend (Ollama or LM Studio) ---
# Provider: ollama | lmstudio | openai-compatible
AI_PROVIDER=ollama

# Upstream origin (no /v1 suffix)
# Ollama default:  http://127.0.0.1:11434
# LM Studio default: http://127.0.0.1:1234
AI_BASE_URL=http://127.0.0.1:11434

# Default model when the client omits `model`
# Examples: llama3.2:1b, llama3.2, mistral, gemma2:2b, or whatever LM Studio has loaded
AI_MODEL=llama3.2:1b

# Optional Bearer token (LM Studio can require one; Ollama ignores it)
AI_API_KEY=

# Port for `npm run ai:server` (Vite proxies /api/ai → this port in dev)
AI_SERVER_PORT=8787
